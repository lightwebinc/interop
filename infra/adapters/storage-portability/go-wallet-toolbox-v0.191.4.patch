+package storage
+
+import (
+	"context"
+	"encoding/hex"
+	"testing"
+	"time"
+
+	"github.com/bsv-blockchain/go-sdk/transaction"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/internal/storage/database/models"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/internal/storage/dbretry"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/internal/storage/repo"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/internal/testabilities/dbfixtures"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/wdk"
+	"github.com/stretchr/testify/require"
+)
+
+// Public signed transactions and proof retained from native run42680240116.
+const ancestryFixture = ""
+const subjectFixture = ""
+
+func TestSyncAncestryExportsActualPublicParents(t *testing.T) {
+	db, cleanup := dbfixtures.TestDatabase(t)
+	defer cleanup()
+	bytes, err := hex.DecodeString(ancestryFixture)
+	require.NoError(t, err)
+	graph, err := transaction.NewBeefFromBytes(bytes)
+	require.NoError(t, err)
+	for _, entry := range graph.Transactions {
+		tx := entry.Transaction
+		require.NotNil(t, tx)
+		row := models.KnownTx{TxID: tx.TxID().String(), RawTx: tx.Bytes()}
+		if tx.MerklePath != nil {
+			row.MerklePath = tx.MerklePath.Bytes()
+		}
+		require.NoError(t, db.DB.Create(&row).Error)
+	}
+	raw, err := hex.DecodeString(subjectFixture)
+	require.NoError(t, err)
+	subject, err := transaction.NewTransactionFromBytes(raw)
+	require.NoError(t, err)
+	require.NoError(t, db.DB.Create(&models.KnownTx{TxID: subject.TxID().String(), RawTx: raw}).Error)
+	provider := &Provider{repo: repo.NewSQLRepositories(db.DB, dbretry.NoRetry())}
+	chunk := wdk.NewSyncChunk("from", "to", "owner")
+	chunk.ProvenTxReqs = []*wdk.TableProvenTxReq{{TxID: subject.TxID().String(), RawTx: raw, Notify: "private-owner-notify"}}
+	require.NoError(t, provider.completeSyncInputBEEF(context.Background(), chunk))
+	exported, err := transaction.NewBeefFromBytes(chunk.ProvenTxReqs[0].InputBEEF)
+	require.NoError(t, err)
+	require.Nil(t, exported.FindTransaction(subject.TxID().String()), "input BEEF excludes signed subject")
+	require.Equal(t, len(graph.Transactions), len(exported.Transactions))
+	require.Equal(t, "private-owner-notify", chunk.ProvenTxReqs[0].Notify)
+	require.Len(t, chunk.ProvenTxReqs, 1)
+	require.Len(t, chunk.Transactions, 0, "no other owner's transaction records exported")
+	require.Len(t, exported.BUMPs, 1)
+	first := append([]byte(nil), chunk.ProvenTxReqs[0].InputBEEF...)
+	require.NoError(t, provider.completeSyncInputBEEF(context.Background(), chunk))
+	require.Equal(t, first, []byte(chunk.ProvenTxReqs[0].InputBEEF), "deterministic closure encoding")
+	unrelated, err := transaction.NewTransactionFromBytes(raw)
+	require.NoError(t, err)
+	unrelated.LockTime++
+	_, err = graph.MergeTransaction(unrelated)
+	require.NoError(t, err)
+	extra, err := graph.Bytes()
+	require.NoError(t, err)
+	require.NoError(t, db.DB.Model(&models.KnownTx{}).Where("tx_id = ?", subject.TxID().String()).Update("input_beef", extra).Error)
+	require.NoError(t, provider.completeSyncInputBEEF(context.Background(), chunk))
+	pruned, err := transaction.NewBeefFromBytes(chunk.ProvenTxReqs[0].InputBEEF)
+	require.NoError(t, err)
+	require.Nil(t, pruned.FindTransaction(unrelated.TxID().String()), "stored batch extras must not leak through owner ancestry export")
+	require.Equal(t, first, []byte(chunk.ProvenTxReqs[0].InputBEEF))
+	require.NoError(t, db.DB.Model(&models.KnownTx{}).Where("tx_id = ?", subject.TxID().String()).Update("input_beef", nil).Error)
+
+	chunk.ProvenTxReqs[0].RawTx = append([]byte(nil), raw...)
+	chunk.ProvenTxReqs[0].RawTx[0] ^= 1
+	require.ErrorContains(t, provider.completeSyncInputBEEF(context.Background(), chunk), "raw transaction differs")
+	chunk.ProvenTxReqs[0].RawTx = raw
+	require.NoError(t, db.DB.Delete(&models.KnownTx{}, "tx_id = ?", "f81c06b9c0e158d9ae92c02c4feb94e783fb0f010f184c6df83b1fc9a4042cf9").Error)
+	require.ErrorContains(t, provider.completeSyncInputBEEF(context.Background(), chunk), "not known to storage", "no fixture or service fetch may repair an absent ancestor")
+}
+
+func TestSyncAncestrySizeBoundPreservesCombinedKnownCursor(t *testing.T) {
+	chunk := wdk.NewSyncChunk("from", "to", "owner")
+	now := time.Now()
+	chunk.ProvenTxs = []*wdk.TableProvenTx{{TxID: "b", CreatedAt: now}}
+	chunk.ProvenTxReqs = []*wdk.TableProvenTxReq{{TxID: "a", CreatedAt: now}, {TxID: "c", CreatedAt: now.Add(-time.Second)}}
+	bounded, err := boundSyncAncestryChunk(chunk, 1)
+	require.NoError(t, err)
+	require.Len(t, bounded.ProvenTxReqs, 1)
+	require.Equal(t, "a", bounded.ProvenTxReqs[0].TxID)
+	require.Empty(t, bounded.ProvenTxs, "combined SQL prefix cannot skip the earlier request")
+	require.Empty(t, bounded.Transactions)
+	require.Len(t, chunk.ProvenTxReqs, 2, "original observation remains unchanged")
+}
+
+func TestSyncAncestryRepeatedTinyPagesHaveNoSkips(t *testing.T) {
+	now := time.Now()
+	want := []string{"b", "d", "a", "c"}
+	seen := []string{}
+	// The actual shared SQL cursor is offset(provenTx)+offset(provenTxReq).
+	for cursor := 0; cursor < len(want); cursor++ {
+		chunk := wdk.NewSyncChunk("from", "to", "owner")
+		for _, id := range want[cursor:] {
+			at := now
+			if id == "a" || id == "c" {
+				at = now.Add(-time.Second)
+			}
+			if id == "b" || id == "c" {
+				chunk.ProvenTxs = append(chunk.ProvenTxs, &wdk.TableProvenTx{TxID: id, CreatedAt: at})
+			} else {
+				chunk.ProvenTxReqs = append(chunk.ProvenTxReqs, &wdk.TableProvenTxReq{TxID: id, CreatedAt: at})
+			}
+		}
+		page, err := boundSyncAncestryChunk(chunk, 1)
+		require.NoError(t, err)
+		require.Equal(t, 1, len(page.ProvenTxs)+len(page.ProvenTxReqs))
+		if len(page.ProvenTxs) > 0 {
+			seen = append(seen, page.ProvenTxs[0].TxID)
+		} else {
+			seen = append(seen, page.ProvenTxReqs[0].TxID)
+		}
+	}
+	require.Equal(t, want, seen)
+}
