+package storage
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"time"
+
+	"github.com/bsv-blockchain/go-sdk/chainhash"
+	"github.com/bsv-blockchain/go-sdk/transaction"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/wdk"
+)
+
+// completeSyncInputBEEF exports the public ancestor graph required by each
+// signed owner transaction. A storage-local known-tx optimization may have
+// persisted an empty InputBEEF because another user's transaction already
+// anchored its inputs. Those global rows are deliberately excluded from the
+// owner's sync dataset. Sending the same empty blob to a fresh counterpart
+// therefore loses usable proof ancestry even though every owned row arrives.
+//
+// Resolve only authenticated owner rows selected by GetSyncChunk, through the
+// existing storage-only BEEF builder. No network fetch, other user's metadata,
+// additional entity/page, or synthetic proof is involved. Remove the subject
+// itself: InputBEEF carries its ancestors, while rawTx retains the signed tx.
+// Expansion is deterministic and leaves statuses, timestamps, labels, notify
+// links and all other portable fields unchanged. Pending unsigned rows retain
+// their original representation until they have an actual signed transaction.
+func (p *Provider) completeSyncInputBEEF(ctx context.Context, chunk *wdk.SyncChunk) error {
+	cache := map[string][]byte{}
+	complete := func(txid string, raw []byte) ([]byte, error) {
+		if value, ok := cache[txid]; ok {
+			return value, nil
+		}
+		beef, err := p.repo.KnownTx.GetBEEFForTxID(ctx, txid)
+		if err != nil {
+			return nil, err
+		}
+		hash, err := chainhash.NewHashFromHex(txid)
+		if err != nil {
+			return nil, err
+		}
+		subject := beef.FindAtomicTransaction(txid)
+		if subject == nil {
+			return nil, fmt.Errorf("missing signed subject %s", txid)
+		}
+		// A mismatching row cannot substitute a different graph in the sync export.
+		if string(subject.Bytes()) != string(raw) {
+			return nil, fmt.Errorf("raw transaction differs for %s", txid)
+		}
+		// Rebuild only the reachable graph: stored batch BEEFs may also carry
+		// unrelated public transactions. Those are not this owner's ancestry.
+		beef, err = transaction.NewBeefFromTransaction(subject)
+		if err != nil {
+			return nil, err
+		}
+		beef.RemoveExistingTxid(hash)
+		encoded, err := beef.Bytes()
+		if err != nil {
+			return nil, err
+		}
+		cache[txid] = encoded
+		return encoded, nil
+	}
+	for _, row := range chunk.ProvenTxReqs {
+		if len(row.RawTx) == 0 || row.TxID == "" {
+			continue
+		}
+		value, err := complete(row.TxID, row.RawTx)
+		if err != nil {
+			return fmt.Errorf("request %s: %w", row.TxID, err)
+		}
+		row.InputBEEF = value
+	}
+	return nil
+}
+
+// The protocol's rough-size rule includes the item crossing the limit and
+// stops afterwards. Reapply it after expansion; offsets count only emitted
+// rows, so the omitted suffix is requested normally on the next page.
+func boundSyncAncestryChunk(chunk *wdk.SyncChunk, maximum uint64) (*wdk.SyncChunk, error) {
+	if maximum == 0 {
+		return chunk, nil
+	}
+	result := wdk.NewSyncChunk(chunk.FromStorageIdentityKey, chunk.ToStorageIdentityKey, chunk.UserIdentityKey)
+	result.User = chunk.User
+	source, target := reflect.ValueOf(chunk).Elem(), reflect.ValueOf(result).Elem()
+
+	type item struct {
+		field string
+		value reflect.Value
+	}
+	var rows []item
+	appendField := func(name string) {
+		values := source.FieldByName(name)
+		for i := 0; i < values.Len(); i++ {
+			rows = append(rows, item{name, values.Index(i)})
+		}
+	}
+	appendField("OutputBaskets")
+	// KnownTx uses one combined SQL cursor (sum of the two offsets). Preserve
+	// that exact created_at DESC, tx_id ASC order when cutting its prefix.
+	var known []item
+	for _, name := range []string{"ProvenTxs", "ProvenTxReqs"} {
+		values := source.FieldByName(name)
+		for i := 0; i < values.Len(); i++ {
+			known = append(known, item{name, values.Index(i)})
+		}
+	}
+	sort.SliceStable(known, func(i, j int) bool {
+		a, b := known[i].value.Elem(), known[j].value.Elem()
+		at, bt := a.FieldByName("CreatedAt").Interface().(time.Time), b.FieldByName("CreatedAt").Interface().(time.Time)
+		if !at.Equal(bt) {
+			return at.After(bt)
+		}
+		return a.FieldByName("TxID").String() < b.FieldByName("TxID").String()
+	})
+	rows = append(rows, known...)
+	for _, name := range []string{"Transactions", "Outputs", "TxLabels", "TxLabelMaps", "OutputTags", "OutputTagMaps", "Certificates", "CertificateFields", "Commissions"} {
+		appendField(name)
+	}
+	for _, row := range rows {
+		output := target.FieldByName(row.field)
+		output.Set(reflect.Append(output, row.value))
+		encoded, err := json.Marshal(result)
+		if err != nil {
+			return nil, fmt.Errorf("cannot size completed sync ancestry: %w", err)
+		}
+		if uint64(len(encoded)) > maximum {
+			return result, nil
+		}
+	}
+	return result, nil
+}
