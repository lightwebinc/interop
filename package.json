{
  "name": "tpnil",
  "version": "0.5.0",
  "private": true,
  "description": "Transaction Processing Network Interoperability Laboratory",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node bin/tpnil.mjs check && node scripts/check-itcve-go.mjs",
    "qualify:standards": "node bin/tpnil.mjs qualify-standards",
    "test:synthesis": "npm ci --prefix synthesis --ignore-scripts && npm run typecheck --prefix synthesis && npm test --prefix synthesis",
    "qualification": "node bin/tpnil.mjs run-qualification infra/plans/todo-webroot-qualification.json . out/todo-webroot-qualification local-operator",
    "verify:journals": "node scripts/verify-published-journals.mjs",
    "demo": "node bin/tpnil.mjs demo",
    "prepare:go": "node scripts/prepare-itcve-go.mjs",
    "test:go": "npm run prepare:go && node scripts/test-itcve-go.mjs"
  },
  "license": "Apache-2.0"
}
